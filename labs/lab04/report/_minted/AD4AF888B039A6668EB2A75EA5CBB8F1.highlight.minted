\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{time}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{emptyNet}\PYG{p}{():}

    \PYG{l+s+s2}{\PYGZdq{}Create an empty network and add nodes to it.\PYGZdq{}}

    \PYG{n}{net} \PYG{o}{=} \PYG{n}{Mininet}\PYG{p}{(} \PYG{n}{controller}\PYG{o}{=}\PYG{n}{Controller}\PYG{p}{,} \PYG{n}{waitConnected}\PYG{o}{=}\PYG{k+kc}{True} \PYG{p}{)}

    \PYG{n}{info}\PYG{p}{(} \PYG{l+s+s1}{\PYGZsq{}*** Adding controller}\PYG{l+s+se}{\PYGZbs{}n}\PYG{l+s+s1}{\PYGZsq{}} \PYG{p}{)}
    \PYG{n}{net}\PYG{o}{.}\PYG{n}{addController}\PYG{p}{(} \PYG{l+s+s1}{\PYGZsq{}c0\PYGZsq{}} \PYG{p}{)}

