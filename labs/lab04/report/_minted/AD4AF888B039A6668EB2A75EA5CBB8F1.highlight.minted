    \PYG{n}{h2}\PYG{o}{.}\PYG{n}{cmdPrint}\PYG{p}{(} \PYG{l+s+s1}{\PYGZsq{}tc qdisc add dev h2\PYGZhy{}eth0 root netem delay 100ms\PYGZsq{}} \PYG{p}{)}

    \PYG{n}{time}\PYG{o}{.}\PYG{n}{sleep}\PYG{p}{(}\PYG{l+m+mi}{10}\PYG{p}{)} \PYG{c+c1}{\PYGZsh{} Wait 10 seconds}

    \PYG{n}{info}\PYG{p}{(} \PYG{l+s+s1}{\PYGZsq{}*** Ping}\PYG{l+s+se}{\PYGZbs{}n}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
