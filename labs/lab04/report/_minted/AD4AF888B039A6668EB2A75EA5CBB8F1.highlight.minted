    \PYG{n}{net}\PYG{o}{.}\PYG{n}{addLink}\PYG{p}{(} \PYG{n}{h1}\PYG{p}{,} \PYG{n}{s1} \PYG{p}{)}
    \PYG{n}{net}\PYG{o}{.}\PYG{n}{addLink}\PYG{p}{(} \PYG{n}{h2}\PYG{p}{,} \PYG{n}{s1} \PYG{p}{)}

